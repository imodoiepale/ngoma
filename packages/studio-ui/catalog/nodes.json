{
  "version": 1,
  "note": "One node catalogue for the studio canvas and packages/strategy/workflow_author.py. A node's backend says what actually runs it: a ComfyUI workflow from workflows/manifest.json, a hosted router profile, a Python module in this repo, a publisher, or `gap` when nothing in the studio can do it yet. Gaps are shown, never faked.",
  "types": {
    "text": {"label": "Text", "color": "#E2BE6A"},
    "image": {"label": "Image", "color": "#7DB4F5"},
    "video": {"label": "Video", "color": "#B98CF2"},
    "audio": {"label": "Audio", "color": "#6CCFAE"},
    "brand": {"label": "Brand kit", "color": "#E9876A"},
    "character": {"label": "Character", "color": "#F2A3C7"},
    "post": {"label": "Post", "color": "#A3ADBB"}
  },
  "categories": [
    {"id": "inputs", "label": "Inputs"},
    {"id": "generate", "label": "Generate"},
    {"id": "edit", "label": "Edit"},
    {"id": "brand", "label": "Brand and copy"},
    {"id": "voice", "label": "Voice"},
    {"id": "publish", "label": "Publish"}
  ],
  "nodes": [
    {"kind": "brief", "label": "Brief", "category": "inputs", "blurb": "What this piece should say and to whom",
     "inputs": [], "outputs": [{"id": "text", "type": "text"}],
     "params": [{"key": "text", "label": "Brief", "type": "textarea"}],
     "backend": {"kind": "input"}, "steps": ["brief"]},
    {"kind": "reference-images", "label": "Reference images", "category": "inputs", "blurb": "Owned or consented photos",
     "inputs": [], "outputs": [{"id": "images", "type": "image"}],
     "params": [{"key": "folder", "label": "Folder", "type": "text"}],
     "backend": {"kind": "input"}, "steps": ["reference-images"]},
    {"kind": "product-photo", "label": "Product photo", "category": "inputs", "blurb": "The real product, shot on a phone is fine",
     "inputs": [], "outputs": [{"id": "image", "type": "image"}],
     "params": [{"key": "file", "label": "File", "type": "text"}],
     "backend": {"kind": "input"}, "steps": ["product-photo"]},
    {"kind": "video-clip", "label": "Video clip", "category": "inputs", "blurb": "Footage or a motion reference",
     "inputs": [], "outputs": [{"id": "video", "type": "video"}],
     "params": [{"key": "file", "label": "File", "type": "text"}],
     "backend": {"kind": "input"}, "steps": ["video-clip"]},
    {"kind": "song", "label": "Song", "category": "inputs", "blurb": "Licensed master or voice track",
     "inputs": [], "outputs": [{"id": "audio", "type": "audio"}],
     "params": [{"key": "file", "label": "File", "type": "text"}],
     "backend": {"kind": "input"}, "steps": ["song"]},
    {"kind": "brand-kit", "label": "Brand kit", "category": "inputs", "blurb": "Logo, palette and type from brand.yaml",
     "inputs": [], "outputs": [{"id": "brand", "type": "brand"}],
     "params": [],
     "backend": {"kind": "brand"}, "steps": ["brand-kit", "brandkit"]},

    {"kind": "image-hosted", "label": "Image (hosted)", "category": "generate", "blurb": "Nano Banana 2 or GPT Image 2 through OpenRouter",
     "inputs": [{"id": "prompt", "type": "text"}, {"id": "reference", "type": "image", "optional": true}],
     "outputs": [{"id": "image", "type": "image"}],
     "params": [{"key": "profile", "label": "Profile", "type": "select", "options": ["concept_draft", "daily_premium", "brand_master_4k"], "default": "daily_premium"},
                {"key": "ratio", "label": "Ratio", "type": "select", "options": ["1:1", "4:5", "9:16", "16:9"], "default": "4:5"}],
     "backend": {"kind": "router", "profile": "daily_premium"}, "steps": ["nano-banana-2", "image-hosted"]},
    {"kind": "klein-t2i", "label": "Flux Klein text to image", "category": "generate", "blurb": "Open model on the pod, about 444 images per GPU hour",
     "inputs": [{"id": "prompt", "type": "text"}], "outputs": [{"id": "image", "type": "image"}],
     "params": [{"key": "count", "label": "Images", "type": "number", "default": 45}],
     "backend": {"kind": "comfy", "workflow": "api-tests/klein-t2i-test.json"}, "steps": ["klein-t2i", "qwen-image"]},
    {"kind": "image-edit", "label": "Image edit", "category": "generate", "blurb": "Qwen / Klein edit: relight, restyle, new room, new outfit",
     "inputs": [{"id": "image", "type": "image"}, {"id": "prompt", "type": "text"}], "outputs": [{"id": "image", "type": "image"}],
     "params": [{"key": "instruction", "label": "Edit", "type": "textarea"}],
     "backend": {"kind": "comfy", "workflow": "icekiub/QWEN_IMAGE_UNLEASHED_ICEKIUB_SUBS_-_v1_.json"},
     "steps": ["klein-edit", "realism-img2img", "klein-consistent-room", "infinite-wardrobe", "product-relight"]},
    {"kind": "carousel", "label": "Carousel poses", "category": "generate", "blurb": "One photo becomes a consistent photoset",
     "inputs": [{"id": "image", "type": "image"}], "outputs": [{"id": "images", "type": "image"}],
     "params": [{"key": "slides", "label": "Slides", "type": "number", "default": 6}],
     "backend": {"kind": "comfy", "workflow": "icekiub/Carousel_Pose_changer_-_Icekiub_V1.7.json"},
     "steps": ["carousel-pose-changer", "carousel"]},
    {"kind": "dataset", "label": "Character dataset", "category": "generate", "blurb": "A 40-image training set and character board",
     "inputs": [{"id": "images", "type": "image"}], "outputs": [{"id": "images", "type": "image"}],
     "params": [],
     "backend": {"kind": "comfy", "workflow": "icekiub/INFLUENCER_Dataset_AIO_-_Klein_Revamped_-_Subs_-_Icekiub_v2.json"},
     "consent": true, "steps": ["dataset-aio", "dataset-fictional", "character-board"]},
    {"kind": "refmod-create", "label": "RefMod character", "category": "generate", "blurb": "A reusable character in seconds, no training",
     "inputs": [{"id": "images", "type": "image"}], "outputs": [{"id": "character", "type": "character"}],
     "params": [{"key": "preset", "label": "Preset", "type": "select", "options": ["identity", "style", "motion"], "default": "identity"}],
     "backend": {"kind": "comfy", "workflow": "h3-refmods/franckyb-refmod-create-from-folder.json"},
     "consent": true, "steps": ["refmod", "refmod-consented", "persona-refmod", "lora-or-refmod"]},
    {"kind": "lora-train", "label": "LoRA training", "category": "generate", "blurb": "Train a character LoRA",
     "inputs": [{"id": "images", "type": "image"}], "outputs": [{"id": "character", "type": "character"}],
     "params": [],
     "backend": {"kind": "gap", "reason": "No LoRA training workflow in the library yet (ai-toolkit runs outside ComfyUI). Use RefMod character instead."},
     "consent": true, "steps": ["ai-toolkit-lora", "lora"]},
    {"kind": "faceswap", "label": "Face swap", "category": "generate", "blurb": "Consented faces only",
     "inputs": [{"id": "image", "type": "image"}, {"id": "face", "type": "image"}], "outputs": [{"id": "image", "type": "image"}],
     "params": [],
     "backend": {"kind": "comfy", "workflow": "icekiub/QWEN_ICY_Faceswap_-_SUBS_-_Icekiub_v1.json"},
     "consent": true, "steps": ["faceswap-consented"]},
    {"kind": "character-video", "label": "Character video (H3)", "category": "generate", "blurb": "MiniMax H3 reference-to-video with a RefMod",
     "inputs": [{"id": "character", "type": "character"}, {"id": "prompt", "type": "text"}], "outputs": [{"id": "video", "type": "video"}],
     "params": [{"key": "seconds", "label": "Seconds", "type": "number", "default": 5}],
     "backend": {"kind": "comfy", "workflow": "h3-refmods/dainamo-refmod-generate.json"},
     "steps": ["h3-ref2va"]},
    {"kind": "long-video", "label": "Long video (H3)", "category": "generate", "blurb": "Image to long video with extension",
     "inputs": [{"id": "image", "type": "image"}, {"id": "prompt", "type": "text"}], "outputs": [{"id": "video", "type": "video"}],
     "params": [{"key": "seconds", "label": "Seconds", "type": "number", "default": 30}],
     "backend": {"kind": "comfy", "workflow": "3-Image-To-Long-Video/3-Image-To-Long-Video.json"},
     "steps": ["h3-infinite", "reels"]},
    {"kind": "image-to-video", "label": "Image to video (WAN)", "category": "generate", "blurb": "Animate a still",
     "inputs": [{"id": "image", "type": "image"}, {"id": "prompt", "type": "text"}], "outputs": [{"id": "video", "type": "video"}],
     "params": [{"key": "seconds", "label": "Seconds", "type": "number", "default": 5}],
     "backend": {"kind": "comfy", "workflow": "icekiub/I2V_Infinite_extender_-_SUBS_-_Icekiub_v1.json"},
     "steps": ["wan-i2v"]},
    {"kind": "text-to-video", "label": "Text to video (LTX)", "category": "generate", "blurb": "Shots from a prompt alone",
     "inputs": [{"id": "prompt", "type": "text"}], "outputs": [{"id": "video", "type": "video"}],
     "params": [{"key": "seconds", "label": "Seconds", "type": "number", "default": 5}],
     "backend": {"kind": "comfy", "workflow": "icekiub/LTX2-T2V_-_ICY.json"},
     "steps": ["ltx", "wan-t2v"]},
    {"kind": "motion-transfer", "label": "Motion transfer (SCAIL)", "category": "generate", "blurb": "Move a character like the reference clip",
     "inputs": [{"id": "image", "type": "image"}, {"id": "motion", "type": "video"}], "outputs": [{"id": "video", "type": "video"}],
     "params": [],
     "backend": {"kind": "comfy", "workflow": "scail2/SCAIL-2_Animation.json"},
     "steps": ["scail-motion"]},
    {"kind": "lipsync", "label": "Image and audio to video", "category": "generate", "blurb": "A performance driven by the song or voice",
     "inputs": [{"id": "image", "type": "image"}, {"id": "audio", "type": "audio"}], "outputs": [{"id": "video", "type": "video"}],
     "params": [],
     "backend": {"kind": "comfy", "workflow": "MiniMax-H3-Simple-WF/IMG-_-Audio-To-Video.json"},
     "consent": true, "steps": ["lipsync"]},

    {"kind": "upscale-video", "label": "Upscale video", "category": "edit", "blurb": "Latent upscale with de-rope",
     "inputs": [{"id": "video", "type": "video"}], "outputs": [{"id": "video", "type": "video"}],
     "params": [],
     "backend": {"kind": "comfy", "workflow": "h3/NEW_-_V2V_Latent_Motion_Transfer_with_upscale_and_de-rope_.json"},
     "steps": ["upscale"]},
    {"kind": "restore", "label": "Restore photo", "category": "edit", "blurb": "Repair and colourise old photos",
     "inputs": [{"id": "image", "type": "image"}], "outputs": [{"id": "image", "type": "image"}],
     "params": [],
     "backend": {"kind": "gap", "reason": "No restoration workflow in the library yet."},
     "steps": ["restore"]},
    {"kind": "relight", "label": "Relight", "category": "edit", "blurb": "Change the light on footage",
     "inputs": [{"id": "video", "type": "video"}], "outputs": [{"id": "video", "type": "video"}],
     "params": [],
     "backend": {"kind": "gap", "reason": "No video relight workflow in the library yet."},
     "steps": ["relight"]},
    {"kind": "cut", "label": "Cut and loop", "category": "edit", "blurb": "Trim, loop and pick the best clips",
     "inputs": [{"id": "video", "type": "video"}], "outputs": [{"id": "video", "type": "video"}],
     "params": [{"key": "seconds", "label": "Length", "type": "number", "default": 8}],
     "backend": {"kind": "python", "module": "packages/voice/mux.py"},
     "steps": ["loop-edit", "edit", "clip-select"]},
    {"kind": "motion-graphics", "label": "Motion graphics", "category": "edit", "blurb": "Kinetic type and phone mock-ups",
     "inputs": [{"id": "script", "type": "text"}], "outputs": [{"id": "video", "type": "video"}],
     "params": [],
     "backend": {"kind": "gap", "reason": "HyperFrames/Remotion renderer is planned, not built."},
     "steps": ["hyperframes", "remotion", "phone-mockup"]},

    {"kind": "compositor", "label": "Brand compositor", "category": "brand", "blurb": "Exact copy, logo and palette on top, never generated",
     "inputs": [{"id": "media", "type": "image"}, {"id": "brand", "type": "brand"}, {"id": "copy", "type": "text", "optional": true}],
     "outputs": [{"id": "image", "type": "image"}],
     "params": [{"key": "ratio", "label": "Master", "type": "select", "options": ["1:1", "4:5", "3:4", "9:16", "16:9"], "default": "4:5"}],
     "backend": {"kind": "python", "module": "packages/compositor/compositor.py"}, "steps": ["compositor"]},
    {"kind": "claim-check", "label": "Claim check", "category": "brand", "blurb": "Blocks money promises and risky claims",
     "inputs": [{"id": "text", "type": "text"}], "outputs": [{"id": "text", "type": "text"}],
     "params": [],
     "backend": {"kind": "python", "module": "packages/strategy/plan.py"}, "steps": ["claim-check"]},
    {"kind": "hooks", "label": "Hook variants", "category": "brand", "blurb": "Opening lines to test, from a winning format",
     "inputs": [{"id": "text", "type": "text"}], "outputs": [{"id": "text", "type": "text"}],
     "params": [{"key": "count", "label": "Variants", "type": "number", "default": 10}],
     "backend": {"kind": "python", "module": "packages/strategy/study.py"}, "steps": ["hook-variants", "reel-analysis"]},
    {"kind": "captions", "label": "Captions", "category": "brand", "blurb": "Burned-in subtitles from the script",
     "inputs": [{"id": "video", "type": "video"}, {"id": "script", "type": "text", "optional": true}],
     "outputs": [{"id": "video", "type": "video"}],
     "params": [],
     "backend": {"kind": "python", "module": "packages/voice/mux.py"}, "steps": ["captions"]},

    {"kind": "voiceover", "label": "Voiceover", "category": "voice", "blurb": "English, Kiswahili, Sheng or French",
     "inputs": [{"id": "script", "type": "text"}], "outputs": [{"id": "audio", "type": "audio"}],
     "params": [{"key": "language", "label": "Language", "type": "select", "options": ["en", "sw", "sheng", "fr"], "default": "en"}],
     "backend": {"kind": "python", "module": "packages/voice/tts.py"}, "steps": ["tts", "tts-sw", "voiceover"]},
    {"kind": "transcribe", "label": "Transcribe", "category": "voice", "blurb": "Speech to timed text",
     "inputs": [{"id": "media", "type": "video"}], "outputs": [{"id": "text", "type": "text"}],
     "params": [],
     "backend": {"kind": "python", "module": "packages/voice/transcribe.py"}, "steps": ["transcribe"]},
    {"kind": "translate", "label": "Translate", "category": "voice", "blurb": "Script into another language",
     "inputs": [{"id": "text", "type": "text"}], "outputs": [{"id": "text", "type": "text"}],
     "params": [{"key": "language", "label": "Language", "type": "select", "options": ["sw", "fr", "en"], "default": "sw"}],
     "backend": {"kind": "gap", "reason": "No translation adapter yet; write the script in the target language."},
     "steps": ["translate"]},

    {"kind": "postiz", "label": "Schedule post", "category": "publish", "blurb": "Instagram, TikTok and more through Postiz, as a draft",
     "inputs": [{"id": "media", "type": "video"}, {"id": "caption", "type": "text", "optional": true}],
     "outputs": [{"id": "post", "type": "post"}],
     "params": [{"key": "status", "label": "Status", "type": "select", "options": ["draft", "scheduled"], "default": "draft"}],
     "backend": {"kind": "publish", "module": "packages/publish/postiz.py"}, "steps": ["postiz"]},
    {"kind": "whatsapp-status", "label": "WhatsApp Status", "category": "publish", "blurb": "Through OpenWA, after approval",
     "inputs": [{"id": "media", "type": "image"}, {"id": "caption", "type": "text", "optional": true}],
     "outputs": [{"id": "post", "type": "post"}],
     "params": [],
     "backend": {"kind": "publish", "module": "packages/publish/whatsapp.py"}, "steps": ["openwa"]},
    {"kind": "export", "label": "Export files", "category": "publish", "blurb": "Masters and manifest for the client",
     "inputs": [{"id": "media", "type": "image"}], "outputs": [{"id": "post", "type": "post"}],
     "params": [],
     "backend": {"kind": "python", "module": "packages/compositor/compositor.py"}, "steps": ["export", "print-on-demand"]},
    {"kind": "course", "label": "Publish to Whop", "category": "publish", "blurb": "Course or community post",
     "inputs": [{"id": "text", "type": "text"}], "outputs": [{"id": "post", "type": "post"}],
     "params": [],
     "backend": {"kind": "publish", "module": "packages/publish/whop/whop_publish.py"}, "steps": ["whop-publish", "community"]},
    {"kind": "analytics", "label": "Learn from results", "category": "publish", "blurb": "Pull insights, feed memory",
     "inputs": [{"id": "post", "type": "post"}], "outputs": [{"id": "text", "type": "text"}],
     "params": [],
     "backend": {"kind": "python", "module": "packages/analytics/collect.py"}, "steps": ["analytics", "audit-log"]}
  ],
  "media_ports": {"note": "Ports named `media` accept image or video.", "accepts": ["image", "video"]}
}
