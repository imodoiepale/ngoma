# Copy to .env on the VPS and fill in. NEVER commit the filled version.
#   cp .env.example .env && chmod 600 .env

# The public hostname. Must already point at this VPS before `docker compose up`,
# or Caddy cannot get a certificate.
POSTIZ_DOMAIN=postiz.example.com

# openssl rand -hex 32
POSTIZ_JWT_SECRET=
POSTGRES_PASSWORD=

# Posts/hour on the public API. Default 90. Raise only if you actually need a backfill.
POSTIZ_API_LIMIT=90

# --- provider OAuth ---------------------------------------------------------
# Instagram publishing runs through the Meta Graph API, so it needs a Facebook app,
# and the IG account must be Professional AND linked to a Facebook Page.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
