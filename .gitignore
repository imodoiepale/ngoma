# secrets — never commit
.env
.env.*
!.env.example
*.dpapi
*_ed25519
*_ed25519.pub
*.pem
id_rsa*
known_hosts
whop-token*
runpod-token*
hf-token*

# build / deps
node_modules/
.next/
dist/
__pycache__/
*.pyc
.venv/
.uv/

# heavy binaries — stay out of git
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
*.mp4
*.mov
*.webm
*.wav
*.zip
library.sqlite3
graph/*.html
renders/
out/

# pre-existing key material in repo root (do not commit)
filer
filer.pub

# memory db is operational state, not source
packages/memory/memory.sqlite3
packages/orchestrator/control.sqlite3
out/voice/
out/analytics/
brands/*/calendar/plan-loop.*
brands/*/calendar/plan-180d.*

# Large reference material. The style grammars derived from this are what the repo
# needs; the 39.6 MB source PDF is not.
*.pdf

# director engine results: images and clips the runner made, plus their manifests.
# Operational output, often large; the workflow file records what ran and where it landed.
brands/*/runs/

# graphify: the semantic cache is regenerable; the report, graph and manifest are kept
graphify-out/cache/
.graphify_python
